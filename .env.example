# Set unique values in your shell or hosting environment. The application does not load .env automatically.
LOOMOS_SECRET_KEY=replace-with-a-unique-random-value-at-least-32-characters
LOOMOS_DATABASE=instance/loomos.db
LOOMOS_ENV=development
LOOMOS_HOST=127.0.0.1
LOOMOS_COOKIE_SECURE=0
PORT=5000
FLASK_DEBUG=0
# Optional and only for disposable test fixtures; leave unset for an actual workspace.
# LOOMOS_SEED_SAMPLE_DATA=1
